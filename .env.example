# Copie este archivo como .env y cambie los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# --- PostgreSQL (lo usan docker-compose y el backend) ---
POSTGRES_USER=emprendedoras
POSTGRES_PASSWORD=cambie-esta-clave-de-bd
POSTGRES_DB=emprendedoras
DB_HOST=localhost
DB_PUERTO=5432

# Opcional: si se define, reemplaza los valores anteriores.
# DATABASE_URL=postgres://usuario:clave@localhost:5432/emprendedoras?sslmode=disable

# Opcional: base para las pruebas de integración. Si no se define,
# las pruebas usan la misma base en un esquema temporal que se borra al terminar.
# TEST_DATABASE_URL=

# --- Backend ---
PUERTO=8080
DIR_UPLOADS=data/uploads

# Clave de las cuentas de prueba que crea el seed (mínimo 8 caracteres).
# Use una clave inventada solo para este proyecto.
SEED_CLAVE=cambie-esta-clave

# true solo si el sitio se sirve con HTTPS
COOKIE_SEGURA=false
